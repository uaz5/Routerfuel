# Copy this file to .env before running `docker compose up --build`.
# docker-compose.yml reads these automatically if a .env file exists
# alongside it.

# --- Client auth ---
# FALLBACK / break-glass layer only. The primary source of truth for both API
# keys and tiers is now the `client_tiers` Postgres table, which RouterFuel
# re-reads every ROUTERFUEL_CLIENT_SYNC_SECS — so keys provisioned there need
# no restart, and no entry here.
#
# Keys listed here still work (including when Postgres is unreachable), except
# where a client_tiers row for the same hash has active = false, which is
# treated as a real revocation. See src/auth.rs for the lookup order.
#
# Format: sha256hex:ClientName,sha256hex:ClientName
# Use ./scripts/generate-key.sh to create one instead of running
# `echo -n "..." | sha256sum` by hand.
ROUTERFUEL_API_KEYS=

# Static tier assignment, applied once at startup. Rows in client_tiers
# override these. Format: raw_key:pro,raw_key:enterprise
# (raw, not hashed — see README's env var table for why)
ROUTERFUEL_CLIENT_TIERS=

# How often to re-read the client_tiers table, in seconds. Default 30.
# Lower = new signups and tier upgrades apply faster; higher = fewer queries.
ROUTERFUEL_CLIENT_SYNC_SECS=30

# --- Admin dashboard ---
# Required to access /admin/* and /audit/daily (X-Admin-Key header).
# Leave empty and those routes return 503 until you set this.
ROUTERFUEL_ADMIN_KEY=

# --- Shadow mode ---
# Defaults to true (on) if unset — see main.rs's shadow_mode_enabled().
# Any client can trigger a second, fully-billed call via `shadow_model`
# unless this is explicitly "false".
ENABLE_SHADOW_MODE=true
